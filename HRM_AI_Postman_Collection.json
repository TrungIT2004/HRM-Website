              "mode": "raw",
              "raw": "{\n  \"question\": \"Thời giờ làm việc của nhân viên được quy định như thế nào?\",\n  \"user_jobs\": [\"ALL\"],\n  \"department\": \"ALL\",\n  \"top_k\": 3\n}"
            },
            "url": {
              "raw": "{{fastApiUrl}}/api/v1/chat/stream",
              "host": [
                "{{fastApiUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "chat",
                "stream"
              ]
            },
            "description": "Test luồng SSE trực tiếp từ FastAPI."
          }
        }
      ]
    }
  ]
}