  "item": [
    {
      "name": "1. Spring Boot Gateway (Port 8080)",
      "description": "Các API gọi qua Spring Boot. Yêu cầu có Access Token (Bearer Token).",
      "item": [
        {
          "name": "0. Đăng nhập lấy AccessToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    var token = jsonData.accessToken || (jsonData.data && jsonData.data.accessToken) || jsonData.token;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('accessToken', token);",
                  "        console.log('Đã tự động lưu accessToken vào biến Collection!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nguyenminhduc@company.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập để lấy accessToken tự động gán vào các request bên dưới."
          }
        },
        {
          "name": "1. Lượt chat 1 - Hỏi mở đầu (Tự động tạo Conversation & Message)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.conversation_id) {",
                  "        pm.collectionVariables.set('conversationId', jsonData.conversation_id);",
                  "        console.log('Đã lưu conversationId: ' + jsonData.conversation_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Quy định về việc kết hôn thì tôi được nghỉ mấy ngày?\",\n  \"topK\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ai/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ai",
                "chat"
              ]
            },
            "description": "Câu hỏi đầu tiên: Tự động tạo conversation mới, lưu tin nhắn User & AI vào DB, trả về conversation_id."
          }
        },
        {
          "name": "1.1. Chatbot Streaming (Server-Sent Events - SSE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Thời giờ làm việc của nhân viên được quy định như thế nào?\",\n  \"conversationId\": \"{{conversationId}}\",\n  \"topK\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ai/chat/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ai",
                "chat",
                "stream"
              ]
            },
            "description": "Truy vấn Chatbot với phản hồi Streaming (Server-Sent Events). Nhận từng token chữ hiển thị ngay lập tức (First-Token Latency < 0.5s)."
          }
        },
        {
          "name": "1.2. Thử nghiệm Prompt Injection (Bị từ chối an toàn)",
