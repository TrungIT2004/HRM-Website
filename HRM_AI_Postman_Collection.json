            "url": {
              "raw": "{{fastApiUrl}}/api/v1/chat/query",
              "host": [
                "{{fastApiUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "chat",
                "query"
              ]
            },
            "description": "Giả lập kẻ lạ gọi trực tiếp vào FastAPI mà không có secret -> Chặn 403!"
          }
        },
        {
          "name": "3. Gọi FastAPI Streaming trực tiếp (Có Secret -> 200 SSE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Internal-Secret",
                "value": "{{internalSecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
