# LLM Provider Configuration ('gemini', 'nvidia', 'openai', or 'ollama')
LLM_PROVIDER=gemini

# NVIDIA NIM Configuration (OpenAI-compatible API)
# Get API key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RPM=40

# NVIDIA Model Assignments (per task)
# Text2SQL & Routing/Rewrite: nemotron-3.5-super-vl-120b-a12b (supports structured output)
# Answer Generation: minimaxai/minimax-m3.1-flash (strong Vietnamese)
# OCR: nvidia/nemotron-3.5-parse (test Vietnamese extraction first)
# Metadata Enrichment: (deprecated: nvidia/gemma-4-31b-it EOL 2026-11-24)
NVIDIA_MODEL_ROUTE=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_MODEL_SQL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_MODEL_ANS=minimaxai/minimax-m3.1-flash
NVIDIA_MODEL_OCR=nvidia/nemotron-3.5-parse
NVIDIA_MODEL_ENRICH=nvidia/nemotron-3-ultra

# Google Gemini API Configuration (Multiple keys for quota rotation)
# Get API keys from https://aistudio.google.com/apikey
# GEMINI_API_KEY_0 through GEMINI_API_KEY_6 (7 keys for rotation)
GEMINI_API_KEY_0=your_gemini_api_key_0_here
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here
GEMINI_API_KEY_5=your_gemini_api_key_5_here
GEMINI_API_KEY_6=your_gemini_api_key_6_here
# Single fallback key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Assignments
GEMINI_MODEL_ROUTE=gemini-3.5-flash-lite
GEMINI_MODEL_SQL=gemini-3.5-flash-lite
GEMINI_MODEL_ANS=gemini-3.5-flash-lite
GEMINI_OCR_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_MODEL_JUDGE=gemini-3.5-flash-lite
# Enrichment model (uses 7-key rotation with token bucket, 30 RPM)
GEMINI_MODEL_ENRICH=gemini-3.5-flash-lite

# Rate Limits (Free Tier defaults)
GEMINI_RPM_ROUTE=30
GEMINI_RPM_SQL=15
GEMINI_RPM_ANS=15
# Enrichment rate limit (separate from chat pipeline)
GEMINI_RPM_ENRICH=30
GEMINI_TPM_ROUTE=16000
GEMINI_TPM_SQL=250000
GEMINI_TPM_ANS=250000
GEMINI_DAILY_ROUTE=14000
GEMINI_DAILY_SQL=500
GEMINI_DAILY_ANS=500

# Ollama API Configuration (For Open Source Models)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=gemma4:31b

# Local Embedding (Offline 768d, GPU/CPU, 100% Free)
LOCAL_EMBEDDING_MODEL=google/embeddinggemma-300m

# Google Gemini API Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MODEL_JUDGE=gemini-3.5-flash-lite

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hrm_ai

# Business DB for Text-to-SQL (read-only role hrm_ai_reader, see sql/readonly_role.sql)
HRM_DATABASE_URL=postgresql://hrm_ai_reader:thay_mat_khau_manh_o_day@localhost:5432/hrm

# Ingestion Settings
MAX_CHUNK_TOKENS=1000
MIN_CHUNK_TOKENS=50
GENERATE_HYPOTHETICAL_QUESTIONS=true
NUM_HYPOTHETICAL_QUESTIONS=3

# Internal API Secret (must match backend's ai.service.internal-secret)
INTERNAL_API_SECRET=[REDACTED]
