# LLM Provider Configuration ('gemini', 'openai', or 'ollama')
LLM_PROVIDER=ollama

# Ollama API Configuration (For Open Source Models)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=gpt-oss:120B

# Google Gemini API Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:@Minhtrung1408@localhost:5432/hrm

# Ingestion Settings
MAX_CHUNK_TOKENS=1000
MIN_CHUNK_TOKENS=50
GENERATE_HYPOTHETICAL_QUESTIONS=true
NUM_HYPOTHETICAL_QUESTIONS=3
