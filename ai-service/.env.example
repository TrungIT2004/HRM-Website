# LLM Provider Configuration ('gemini', 'openai', or 'ollama')
LLM_PROVIDER=ollama

# Ollama API Configuration (For Open Source Models)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=gemma4:31b

# Local Embedding (Offline 768d, GPU/CPU, 100% Free)
LOCAL_EMBEDDING_MODEL=google/embeddinggemma-300m

# Google Gemini API Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hrm_ai

# Business DB for Text-to-SQL (read-only role hrm_ai_reader, see sql/readonly_role.sql)
HRM_DATABASE_URL=postgresql://hrm_ai_reader:thay_mat_khau_manh_o_day@localhost:5432/hrm

# Ingestion Settings
MAX_CHUNK_TOKENS=1000
MIN_CHUNK_TOKENS=50
GENERATE_HYPOTHETICAL_QUESTIONS=true
NUM_HYPOTHETICAL_QUESTIONS=3
