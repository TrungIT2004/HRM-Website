.env
.env*.local
*.env
!*.env.example

# Local uploads and documents
uploads/
documents/

# Local model & cache downloads
.cache/
checkpoints/
models/

# Test fixtures exception (do not ignore test files)
!tests/*.docx
!tests/*.xlsx
!tests/*.pdf
